{
  "name": "before-arrival-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "verify": "node verify.mjs",
    "verify:browser": "node browser-verify.mjs",
    "serve": "python3 app_server.py",
    "verify:server": "python3 -m unittest -v test_app_server.py",
    "verify:local-app": "node local-app-browser-verify.mjs",
    "verify:arrival": "node arrival-browser-verify.mjs",
    "verify:refresh-feedback": "node refresh-feedback-browser-verify.mjs",
    "verify:saved-undo": "node saved-undo-browser-verify.mjs && node saved-search-browser-verify.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.57.0"
  }
}
